# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---- App ----
APP_NAME=Curoa.AI
APP_ENV=development
DEBUG=true

# ---- MySQL database ----
# mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://curoa_user:change_me@localhost:3306/curoa_db

# ---- Auth / JWT ----
# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ---- Future integrations (placeholders) ----
# Maps / geolocation API key, used later by the hospitals router
MAPS_API_KEY=
# Medical AI model / provider key, used later by the chat router
AI_MODEL_API_KEY=
